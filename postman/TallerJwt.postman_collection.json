{
  "info": {
    "name": "Taller JWT - Registro, login y perfil",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar las peticiones 1, 2 y 3 en orden. El login guarda el token automáticamente. Las peticiones 4 y 5 verifican el rechazo de accesos incorrectos. Si el usuario ya está registrado, continuar desde Login o cambiar username en las variables de la colección."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "dylan"
    },
    {
      "key": "password",
      "value": "Lazlo2001"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Registrar usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/registrar",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"rol\": \"ADMIN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Usuario registrado\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"token\");",
              "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Ver perfil con token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/perfil",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Perfil autorizado\", () => pm.response.to.have.status(200));",
              "pm.test(\"Usuario correcto\", () => pm.expect(pm.response.json().Usuario).to.eql(pm.collectionVariables.get(\"username\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Ver perfil sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/perfil",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Acceso denegado\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Login con contraseña incorrecta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"incorrecta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Credenciales rechazadas\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
